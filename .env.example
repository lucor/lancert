# Lancert v2 configuration. CLI flags override matching environment values.

# Required: public IPv4 used for the zone apex and nameserver glue.
LANCERT_SERVER_IP=

# Required: high-entropy secret for keyed, privacy-preserving source-IP hashes.
# Changing it resets in-memory source rate-limit identities after restart.
LANCERT_IP_HASH_SALT=

LANCERT_DNS_ADDR=:53
LANCERT_HTTP_ADDR=:8443
LANCERT_DATA_DIR=data
LANCERT_ZONE=lancert.dev.

# Optional trusted reverse-proxy network. Forwarded client addresses are used
# only when the direct peer belongs to this CIDR.
LANCERT_TRUSTED_PROXY=

# Optional static TXT RRsets. Names are relative to LANCERT_ZONE and "@" is
# the apex. Dynamic _acme-challenge owners are reserved.
# Example: {"@":{"ttl":300,"values":["verification-value"]}}
LANCERT_STATIC_TXT=
